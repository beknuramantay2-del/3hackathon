* { font-family: "Segoe UI", "Noto Sans", Arial; font-size: 14px; color: #dce5f2; }
QWidget { background: #111827; }
QWidget#panel, QFrame#panel { background: #192335; border: 1px solid #344258; border-radius: 8px; }
QLabel#title { font-size: 24px; font-weight: 600; color: #f2f6fc; }
QLabel#sectionTitle { font-size: 18px; font-weight: 600; color: #f2f6fc; }
QLabel#eyebrow { color: #a5b3c9; font-size: 14px; font-weight: 600; }
QLabel#directionValue { font-size: 18px; font-weight: 600; color: #f2f6fc; }
QLabel#muted { color: #a5b3c9; }
QLabel#diagnosticText { color: #b9c7da; font-size: 14px; }
QLabel#clock { font-size: 24px; font-weight: 600; padding-left: 12px; }
QLabel#modeBadge { background: #253044; color: #efbb72; border-radius: 6px; padding: 10px; }
QLabel#banner { background: #192335; border: 1px solid #344258; border-radius: 6px; padding: 10px; }
QLabel#observationBadge { background: #192335; border-radius: 6px; padding: 8px; }
QLabel#camera { background: #060b13; border: 1px solid #455674; border-radius: 8px; }
QLabel#cameraHud { background: rgba(6,11,19,215); color: #f2f6fc; font-size: 16px; font-weight: 600; padding: 8px; border-radius: 6px; }
QLabel#calibrationTarget { color: #9ac6ff; background: #172c46; border: 2px solid #cfe4ff; border-radius: 24px; font-size: 32px; }
QLabel#statusBad { color: #f59a98; }
QPushButton { min-height: 24px; background: #2b63a8; border: 1px solid #6094d3; border-radius: 6px; padding: 10px 12px; color: #ffffff; font-weight: 600; }
QPushButton:hover { background: #3474c0; }
QPushButton:focus { border: 2px solid #c2ddff; }
QPushButton:disabled { background: #263243; border-color: #344258; color: #9ba9bd; }
QPushButton#secondary { background: #253044; border-color: #566781; color: #e8eef8; }
QPushButton#secondary:hover { background: #344258; }
QTabWidget::pane { border: 1px solid #344258; border-radius: 6px; background: #141d2c; }
QTabBar::tab { background: #192335; color: #a5b3c9; padding: 12px 10px; border-bottom: 2px solid #344258; }
QTabBar::tab:selected { color: #eff6ff; border-bottom: 2px solid #81b2f4; }
QLineEdit, QListWidget, QDoubleSpinBox { background: #141d2c; border: 1px solid #455674; border-radius: 6px; padding: 6px; }
QListWidget::item { padding: 10px 6px; border-bottom: 1px solid #2b384e; }
QDoubleSpinBox { min-width: 68px; }
QDoubleSpinBox:focus { border-color: #9ac6ff; }
QProgressBar { border: 1px solid #455674; border-radius: 6px; text-align: center; min-height: 26px; color: #eef6ff; background: #182335; }
QProgressBar::chunk { background: #315f96; border-radius: 5px; }
QTableWidget { background: #141d2c; alternate-background-color: #192335; gridline-color: #2d3a50; border: none; font-size: 14px; }
QHeaderView::section { background: #253044; color: #e8eef8; border: none; padding: 8px; font-weight: 600; }
QScrollBar:vertical { background: #192335; width: 10px; }
QScrollBar::handle:vertical { background: #50617c; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QSplitter::handle { background: #344258; width: 2px; }
QLabel#tile { background: #192335; border: 1px solid #344258; border-radius: 6px; padding: 8px; }

QLabel#directionValue[warning="true"] { color: #efbb72; }
QProgressBar[warning="true"]::chunk { background: #805821; }
