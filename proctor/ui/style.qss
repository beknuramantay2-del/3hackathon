* { font-family: "Segoe UI", Arial; font-size: 14px; color: #e6edf6; }
QWidget { background: #0e1420; }
QWidget#panel { background: #182231; border: 1px solid #2b3a50; border-radius: 10px; }
QLabel#title { font-size: 22px; font-weight: bold; color: #75dece; }
QLabel#statusBad { color: #ff8686; }
QLabel#camera { background: #05080d; border: 1px solid #35455d; border-radius: 6px; }
QLineEdit, QListWidget { background: #101926; border: 1px solid #34465e; border-radius: 6px; padding: 8px; }
QPushButton { background: #276eae; border: none; border-radius: 6px; padding: 10px 18px; color: white; }
QPushButton:hover { background: #3386cd; }
QPushButton:disabled { background: #263243; color: #7d91ab; }
QPushButton#secondary { background: #263243; }
QProgressBar { border: 1px solid #34465e; border-radius: 5px; text-align: center; height: 16px; }
QProgressBar::chunk { background: #28a596; }

QLabel#tile { background: #182231; border: 1px solid #2b3a50; border-radius: 6px; padding: 8px; }
